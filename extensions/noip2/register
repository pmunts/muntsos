# Validate parameters

if [ $# -ne 1 ]; then
  echo ""
  echo "Usage: noip2-register <network interface>"
  echo ""
  exit 1
fi

configfile=/usr/local/etc/noip2-$1.conf

# Check for existing configuration file

if [ -f $configfile ]; then
  echo ""
  echo "Error: $configfile already exists."
  echo ""
  exit 1
fi

/usr/local/libexec/noip2 -C -F -I $1 -c $configfile

if [ -f $configfile ]; then
  chmod 400 $configfile
fi

find /usr/local/etc -type f -name 'NO-IP*' -exec rm -f {} ";"

sysconfig --save
